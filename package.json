{
  "name": "pretty-md-reader",
  "displayName": "Pretty MD Reader",
  "description": "Obsidian-style pretty rendering for the built-in Markdown preview, with callouts, Mermaid and Graphviz diagrams.",
  "version": "0.1.0",
  "publisher": "bolaslien",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/bolaslien/pretty-md-reader.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["markdown", "preview", "mermaid", "graphviz", "callouts"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "contributes": {
    "markdown.previewStyles": ["./media/preview.css"],
    "markdown.previewScripts": ["./media/diagram-init.js"],
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Pretty MD Reader",
      "properties": {
        "prettyMdReader.theme": {
          "type": "string",
          "enum": ["purple", "blue", "green", "rose"],
          "enumDescriptions": [
            "Obsidian-style purple (default)",
            "Blue accent",
            "Green accent",
            "Rose accent"
          ],
          "default": "purple",
          "description": "Accent color theme for the Markdown preview. Reload the preview to apply a change."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@hpcc-js/wasm-graphviz": "^1.7.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "markdown-it": "^14.1.0",
    "markdown-it-github-alerts": "^0.3.0",
    "mermaid": "^11.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
